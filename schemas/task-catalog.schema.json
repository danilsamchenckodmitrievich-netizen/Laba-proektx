{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Axiora public task catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subjects",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "label": {
            "$ref": "#/$defs/localized"
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "subject",
          "topic",
          "title",
          "grade",
          "difficulty",
          "statement",
          "illustrations",
          "skills",
          "estimated_minutes",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "subject": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "topic": {
            "$ref": "#/$defs/localized"
          },
          "title": {
            "$ref": "#/$defs/localized"
          },
          "grade": {
            "type": "integer",
            "minimum": 5,
            "maximum": 11
          },
          "difficulty": {
            "enum": [
              "beginner",
              "intermediate",
              "advanced"
            ]
          },
          "statement": {
            "$ref": "#/$defs/localized"
          },
          "illustrations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "src",
                "alt"
              ],
              "additionalProperties": false,
              "properties": {
                "src": {
                  "type": "string",
                  "pattern": "^assets/tasks/[a-z0-9-]+\\.svg$"
                },
                "alt": {
                  "$ref": "#/$defs/localized"
                }
              }
            }
          },
          "skills": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "estimated_minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          },
          "source": {
            "const": "axiora-original"
          }
        }
      }
    }
  },
  "$defs": {
    "localized": {
      "type": "object",
      "required": [
        "ru",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "ru": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
